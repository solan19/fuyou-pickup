<?xml version="1.0" encoding="utf-8"?>
<!--
  在途快递小组件 2×2：状态词（左上） + 承运商（右上） + 最新动态（蓝标签+省略号） + 「全部快递 ×N」胶囊。
  XML 里的文案是**默认值 = 选择器预览**（"快递已到达蜉蝣取件通"，同志 10-16 指定），
  渲染时会被真实数据覆盖。磨砂玻璃材质下颜色由 HomeWidgets 重设。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wmat_card"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 行1：状态词 + 承运商 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已到达"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 行2：最新动态（蓝标签 + 文字省略号） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wtag_blue"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="收"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_trace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="快递已到达蜉蝣取件通"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 行3：全部快递胶囊 -->
        <TextView
            android:id="@+id/w_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/wpill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="📦 全部快递 ×3"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
